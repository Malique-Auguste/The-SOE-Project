# Run PPML regression with 4 lags
model_4 <- fepois(
crime_num ~ x_1_d + x_2_d + x_3_d + x_4 +
s_1_d + s_2_d + s_3_d + s_4 |
grid_id + lambda_num,
data = crime_db,
)
# Run PPML regression with 8 lags
model_8 <- fepois(
crime_num ~ x_1_d + x_2_d + x_3_d + x_4_d + x_5_d + x_6_d + x_7_d + x_8 +
s_1_d + s_2_d + s_3_d + s_4_d + s_5_d + s_6_d + s_7_d + s_8 |
grid_id + lambda_num,
data = crime_db,
)
cutoff_dist <- 5
if (alpha == "0.05") {
cutoff_dist <- 8
} else if (alpha == "0.10") {
cutoff_dist <- 16
}
summary(model_4, vcov = vcov_conley(lat = "lat", lon = "long", cutoff = cutoff_dist, distance = "spherical"))
summary(model_8, vcov = vcov_conley(lat = "lat", lon = "long", cutoff = cutoff_dist, distance = "spherical"))
cmp <- function(v) se(summary(m, vcov = v))[c("x_8", "s_8")]
rbind(
hetero  = cmp("hetero"),
conley  = cmp(vcov_conley(lat = "lat", lon = "long",
cutoff = cutoff_dist, distance = "spherical")),
cell    = cmp(~grid_id),
twoway  = cmp(~grid_id + lambda_num)
)
fml <- crime_num ~ x_1_d + x_2_d + x_3_d + x_4_d + x_5_d + x_6_d + x_7_d + x_8 +
s_1_d + s_2_d + s_3_d + s_4_d + s_5_d + s_6_d + s_7_d + s_8 |
grid_id + lambda_num
est <- crime_db[complete.cases(crime_db[, all.vars(fml)]), ]
est <- est[ave(est$crime_num, est$grid_id, FUN = sum) > 0, ]   # drop all-zero cells
m   <- fepois(fml, data = est)
