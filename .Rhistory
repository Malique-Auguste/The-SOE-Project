setwd("C:/Users/maliq/Projects/The-SOE-Project/")
alpha <- "0.10"
lambda <- "4"
precision <- "True"
crime_db <- read.csv(paste("data/aggr", alpha, lambda, precision, "db.csv", sep = "_"))
# Run PPML regression with 4 lags
model_4 <- fepois(
crime_num ~ x_1_d + x_2_d + x_3_d + x_4 +
s_1_d + s_2_d + s_3_d + s_4 |
grid_id + lambda_num,
data = crime_db,
)
# Run PPML regression with 8 lags
model_8 <- fepois(
crime_num ~ x_1_d + x_2_d + x_3_d + x_4_d + x_5_d + x_6_d + x_7_d + x_8 +
s_1_d + s_2_d + s_3_d + s_4_d + s_5_d + s_6_d + s_7_d + s_8 |
grid_id + lambda_num,
data = crime_db,
)
cutoff_dist <- 5
if (alpha == "0.05") {
cutoff_dist <- 8
} else if (alpha == "0.10") {
cutoff_dist <- 16
}
summary(model_4, vcov = vcov_conley(lat = "lat", lon = "long", cutoff = cutoff_dist, distance = "spherical"))
summary(model_8, vcov = vcov_conley(lat = "lat", lon = "long", cutoff = cutoff_dist, distance = "spherical"))
cutoff_dist <- switch(alpha, "0.03" = 5, "0.05" = 8, "0.10" = 16)
fml_8 <- crime_num ~ x_1_d + x_2_d + x_3_d + x_4_d + x_5_d + x_6_d + x_7_d + x_8 +
s_1_d + s_2_d + s_3_d + s_4_d + s_5_d + s_6_d + s_7_d + s_8 |
grid_id + lambda_num
conley_v <- vcov_conley(lat = "lat", lon = "long",
cutoff = cutoff_dist, distance = "spherical")
df <- crime_db[obs(model_8), ]
stopifnot(nrow(df) == nobs(model_8))
df <- df[order(df$grid_id, df$lambda_num), ]
cat("\n--- panel balance (want ONE value) ---\n"); print(table(table(df$grid_id)))
gaps <- tapply(df$lambda_num, df$grid_id, function(x) any(diff(sort(x)) != 1))
cat("cells with time gaps:", sum(gaps, na.rm = TRUE), "\n")
u    <- sort(unique(df$lambda_num))
step <- as.numeric(names(sort(table(diff(u)), decreasing = TRUE))[1])
cat("period step:", step, "\n")
key  <- paste(df$grid_id, df$lambda_num)
lagw <- function(x, k) x[match(paste(df$grid_id, df$lambda_num - k * step), key)]
lead <- function(x, k) x[match(paste(df$grid_id, df$lambda_num + k * step), key)]
# --- Test 1: residual serial correlation ---
df$e <- residuals(model_8, type = "response")
for (k in 1:8) df[[paste0("rl", k)]] <- lagw(df$e, k)
Tbar <- mean(table(df$grid_id))
cat("null for AR coefficients:", round(-1 / (Tbar - 1), 4), "\n")
print(summary(feols(e ~ rl1, data = df, cluster = ~grid_id)))
ar8 <- feols(e ~ rl1 + rl2 + rl3 + rl4 + rl5 + rl6 + rl7 + rl8,
data = df, cluster = ~grid_id)
print(summary(ar8)); print(wald(ar8, paste0("rl", 1:8)))
# --- Test 3: leads ---
for (k in 1:4) df[[paste0("xF", k)]] <- lead(df$do_num, k)
cat("lead NAs (expect ~", 49 * 4, "):", sum(is.na(df$xF4)), "\n")
m_lead <- fepois(update(fml_8, . ~ . + xF1 + xF2 + xF3 + xF4), data = df)
# ============ ADD ============
u <- sort(unique(df$lambda_num))
cat("\n--- period step ---\n"); print(table(diff(u)))
step <- as.numeric(names(sort(table(diff(u)), decreasing = TRUE))[1])
key  <- paste(df$grid_id, df$lambda_num)
lead <- function(x, k) x[match(paste(df$grid_id, df$lambda_num + k * step), key)]
xv <- c("x_1_d","x_2_d","x_3_d","x_4_d","x_5_d","x_6_d","x_7_d","x_8")
sv <- c("s_1_d","s_2_d","s_3_d","s_4_d","s_5_d","s_6_d","s_7_d","s_8")
df$Xl1 <- rowSums(df[, xv])          # = X_{t-1}
df$Sl1 <- rowSums(df[, sv])          # = S_{t-1}
cat("X_{t-1} sanity (want non-negative, near-integer):\n")
print(summary(df$Xl1)); print(head(sort(unique(df$Xl1)), 6))
for (k in 1:4) {                     # X_{t+k} = Xl1 evaluated at t+k+1
df[[paste0("xF", k)]] <- lead(df$Xl1, k + 1)
df[[paste0("sF", k)]] <- lead(df$Sl1, k + 1)
}
cat("xF4 NAs (expect ~", 49 * 5, "):", sum(is.na(df$xF4)), "\n")
m_lead <- fepois(
crime_num ~ x_1_d + x_2_d + x_3_d + x_4_d + x_5_d + x_6_d + x_7_d + x_8 +
s_1_d + s_2_d + s_3_d + s_4_d + s_5_d + s_6_d + s_7_d + s_8 +
xF1 + xF2 + xF3 + xF4 |
grid_id + lambda_num,
data = df)
print(summary(m_lead, vcov = conley_v))
print(wald(m_lead, paste0("xF", 1:4), vcov = conley_v))
cat("\nx_8: base vs with leads\n")
print(round(c(base = coef(model_8)["x_8"], leads = coef(m_lead)["x_8"]), 4))
# --- Test 2: THE decisive one ---
ses <- function(v) sqrt(diag(vcov(model_8, vcov = v)))
tab <- rbind(hetero = ses("hetero"), conley = ses(conley_v),
cell = ses(~grid_id), twoway = ses(~grid_id + lambda_num))
cat("\n--- SE comparison ---\n"); print(round(tab[, c("x_4_d","x_8","s_8")], 4))
cat("\ncell / conley:\n"); print(round(tab["cell", ] / tab["conley", ], 2))
# ============ END ============
clear
rm(list = ls())
